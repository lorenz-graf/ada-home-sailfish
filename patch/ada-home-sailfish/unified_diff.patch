+/*
+ * ada-home-sailfish: active alarms on the covers page (below the weather),
+ * with a section header. Hidden while no alarm is enabled. Tap opens the
+ * clock app chosen for the clock on Home (default: Clock).
+ * Same data as the Clock app's cover (Nemo.Alarms).
+ * License: BSD-3-Clause, see LICENSE in the ada-home-sailfish project
+ */
+
+import QtQuick 2.6
+import Sailfish.Silica 1.0
+import Nemo.Alarms 1.0
+import Nemo.Configuration 1.0
+import org.nemomobile.lipstick 0.1
+import com.jolla.lipstick 0.1
+
+Column {
+    id: root
+
+    readonly property int count: alarmList.count
+
+    width: parent ? parent.width : 0
+    visible: count > 0
+
+    ConfigurationValue {
+        id: clockAppConfig
+
+        key: "/desktop/lipstick-jolla-home/ada_home/clock_app"
+        defaultValue: ""
+    }
+
+    LauncherItem {
+        id: clockApp
+
+        filePath: clockAppConfig.value || "/usr/share/applications/jolla-clock.desktop"
+    }
+
+    AlarmsModel {
+        id: alarmsModel
+
+        onlyCountdown: false // alarms, not timers
+    }
+
+    EnabledAlarmsProxyModel {
+        id: enabledAlarms
+
+        model: alarmsModel
+    }
+
+    SectionHeader {
+        text: "Alarms"
+    }
+
+    Repeater {
+        id: alarmList
+
+        model: enabledAlarms
+
+        delegate: BackgroundItem {
+            id: alarmItem
+
+            readonly property QtObject alarm: model.alarm
+
+            width: root.width
+            height: Theme.itemSizeSmall
+            onClicked: {
+                if (Desktop.instance && Desktop.instance.switcher) {
+                    Desktop.instance.switcher.activateWindowFor(clockApp)
+                }
+            }
+
+            Label {
+                id: timeLabel
+
+                x: Theme.horizontalPageMargin
+                anchors.verticalCenter: parent.verticalCenter
+                text: {
+                    var d = new Date()
+                    d.setHours(alarmItem.alarm ? alarmItem.alarm.hour : 0)
+                    d.setMinutes(alarmItem.alarm ? alarmItem.alarm.minute : 0)
+                    return Format.formatDate(d, Formatter.TimeValue)
+                }
+                color: alarmItem.highlighted ? Theme.highlightColor : Theme.primaryColor
+                font.pixelSize: Theme.fontSizeLarge
+            }
