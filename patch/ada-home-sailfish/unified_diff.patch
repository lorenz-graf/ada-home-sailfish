+    property bool eventsViewVisible
+
+    spacing: Theme.paddingSmall
+
+    EventsWidgetsModel {
+        id: widgetsModel
+        onlyUserConfigurable: false
+    }
+
+    Repeater {
+        model: widgetsModel
+
+        delegate: Loader {
+            width: root.width
+            visible: active
+            active: model.enabled
+            source: model.path
+        }
+    }
+}
