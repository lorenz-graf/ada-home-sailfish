diff -ruN a/usr/share/lipstick-jolla-home-qt5/eventsview/HomeAppPicker.qml b/usr/share/lipstick-jolla-home-qt5/eventsview/HomeAppPicker.qml
--- /dev/null
+++ b/usr/share/lipstick-jolla-home-qt5/eventsview/HomeAppPicker.qml
@@ -0,0 +1,262 @@
+/*
+ * ada-home-sailfish: app picker.
+ * Search field on top (ignores case, accents and separators), Enter picks
+ * the first match. Optional "Default" row (clock/date) and "Rename" button
+ * (filled home slot: the typed text becomes the slot's label).
+ * License: BSD-3-Clause, see LICENSE in the ada-home-sailfish project
+ * Qt 5.6: plain ES5 JavaScript only.
+ */
+
+import QtQuick 2.6
+import Sailfish.Silica 1.0
+import Sailfish.Lipstick 1.0
+
+Item {
+    id: picker
+
+    property var items: []              // LauncherItems, sorted
+    property string title
+    property string selectedPath        // shows a checkmark
+    property bool showDefault
+    property string defaultLabel
+    property bool defaultSelected
+    property bool renameAllowed
+    property bool autoKeyboard: true
+    property real topMargin
+
+    signal picked(string path)
+    signal defaultPicked()
+    signal renamed(string name)
+    signal cancelled()
+
+    readonly property var filteredItems: _filter(items, searchField.text)
+
+    function open() {
+        searchField.text = ""
+        list.positionViewAtBeginning()
+        if (autoKeyboard) {
+            searchField.forceActiveFocus()
+        }
+    }
+
+    function close() {
+        searchField.focus = false
+    }
+
+    // Lower case, common accents removed, separators removed
+    function _simplify(text) {
+        var s = text.toLowerCase()
+        var accents = [
+            [/[àáâãäåā]/g, "a"], [/[çćč]/g, "c"], [/[èéêëēė]/g, "e"], [/[ìíîïī]/g, "i"],
+            [/[ñń]/g, "n"], [/[òóôõöøō]/g, "o"], [/[ùúûüū]/g, "u"], [/[ýÿ]/g, "y"],
+            [/[šś]/g, "s"], [/[žźż]/g, "z"], [/ß/g, "ss"], [/[łľ]/g, "l"]
+        ]
+        for (var i = 0; i < accents.length; ++i) {
+            s = s.replace(accents[i][0], accents[i][1])
+        }
+        return s.replace(/[\s\-_+,.'`]/g, "")
+    }
+
+    function _filter(all, query) {
+        var q = query.trim().toLowerCase()
+        if (q.length === 0) {
+            return all
+        }
+        var simpleQ = _simplify(q)
+        var result = []
+        for (var i = 0; i < all.length; ++i) {
+            var title = all[i].title
+            if (title.toLowerCase().indexOf(q) !== -1
+                    || (simpleQ.length > 0 && _simplify(title).indexOf(simpleQ) !== -1)) {
+                result.push(all[i])
+            }
+        }
+        return result
+    }
+
+    // Readable on any wallpaper: the ambience's dimmer colour behind the content
+    Rectangle {
+        anchors {
+            top: header.top
+            bottom: parent.bottom
+            left: parent.left
+            right: parent.right
+        }
+        color: Theme.rgba(Theme.highlightDimmerColor, 0.8)
+    }
+
+    Item {
+        id: header
+
+        y: picker.topMargin
+        width: parent.width
+        height: Theme.itemSizeMedium
+
+        Label {
+            anchors {
+                left: parent.left
+                leftMargin: Theme.horizontalPageMargin
+                right: cancelButton.left
+                rightMargin: Theme.paddingMedium
+                verticalCenter: parent.verticalCenter
+            }
+            text: picker.title
+            color: Theme.highlightColor
+            font.pixelSize: Theme.fontSizeLarge
+            truncationMode: TruncationMode.Fade
+        }
+
+        Button {
+            id: cancelButton
+
+            anchors {
+                right: parent.right
+                rightMargin: Theme.horizontalPageMargin
+                verticalCenter: parent.verticalCenter
+            }
+            preferredWidth: Theme.buttonWidthExtraSmall
+            text: "Cancel"
+            onClicked: picker.cancelled()
+        }
+    }
+
+    Item {
+        id: searchRow
+
+        anchors.top: header.bottom
+        width: parent.width
+        height: searchField.height
+
+        SearchField {
+            id: searchField
+
+            anchors {
+                left: parent.left
+                right: renameButton.visible ? renameButton.left : parent.right
+            }
+            placeholderText: picker.renameAllowed ? "Search, or type a new name" : "Search"
+            inputMethodHints: Qt.ImhNoPredictiveText | Qt.ImhNoAutoUppercase
+            EnterKey.iconSource: "image://theme/icon-m-enter-accept"
+            EnterKey.onClicked: {
+                if (picker.filteredItems.length > 0) {
+                    picker.picked(picker.filteredItems[0].filePath)
+                }
+            }
+        }
+
+        Button {
+            id: renameButton
+
+            anchors {
+                right: parent.right
+                rightMargin: Theme.horizontalPageMargin
+                verticalCenter: searchField.verticalCenter
+            }
+            visible: picker.renameAllowed && searchField.text.trim().length > 0
+            preferredWidth: Theme.buttonWidthExtraSmall
+            text: "Rename"
+            onClicked: picker.renamed(searchField.text.trim())
+        }
+    }
+
+    SilicaListView {
+        id: list
+
+        anchors {
+            top: searchRow.bottom
+            bottom: parent.bottom
+            left: parent.left
+            right: parent.right
+        }
+        clip: true
+        model: picker.filteredItems
+
+        header: BackgroundItem {
+            id: defaultItem
+
+            width: list.width
+            height: picker.showDefault ? Theme.itemSizeMedium : 0
+            visible: picker.showDefault
+            onClicked: picker.defaultPicked()
+
+            Label {
+                anchors {
+                    left: parent.left
+                    leftMargin: Theme.horizontalPageMargin + Theme.iconSizeMedium + Theme.paddingLarge
+                    right: defaultCheck.left
+                    rightMargin: Theme.paddingMedium
+                    verticalCenter: parent.verticalCenter
+                }
+                text: picker.defaultLabel
+                color: picker.defaultSelected || defaultItem.highlighted ? Theme.highlightColor : Theme.primaryColor
+                truncationMode: TruncationMode.Fade
+            }
+
+            Icon {
+                id: defaultCheck
+
+                anchors {
+                    right: parent.right
+                    rightMargin: Theme.horizontalPageMargin
+                    verticalCenter: parent.verticalCenter
+                }
+                visible: picker.defaultSelected
+                source: "image://theme/icon-m-acknowledge"
+                color: Theme.highlightColor
+            }
+        }
+
+        delegate: BackgroundItem {
+            id: entry
+
+            readonly property bool selected: picker.selectedPath.length > 0
+                                             && picker.selectedPath === modelData.filePath
+
+            width: list.width
+            height: Theme.itemSizeMedium
+            onClicked: picker.picked(modelData.filePath)
+
+            LauncherIcon {
+                id: icon
+
+                x: Theme.horizontalPageMargin
+                anchors.verticalCenter: parent.verticalCenter
+                icon: modelData.iconId
+                size: Theme.iconSizeMedium
+            }
+
+            Label {
+                anchors {
+                    left: icon.right
+                    leftMargin: Theme.paddingLarge
+                    right: check.left
+                    rightMargin: Theme.paddingMedium
+                    verticalCenter: parent.verticalCenter
+                }
+                text: modelData.title
+                color: entry.selected || entry.highlighted ? Theme.highlightColor : Theme.primaryColor
+                truncationMode: TruncationMode.Fade
+            }
+
+            Icon {
+                id: check
+
+                anchors {
+                    right: parent.right
+                    rightMargin: Theme.horizontalPageMargin
+                    verticalCenter: parent.verticalCenter
+                }
+                visible: entry.selected
+                source: "image://theme/icon-m-acknowledge"
+                color: Theme.highlightColor
+            }
+        }
+
+        ViewPlaceholder {
+            enabled: list.count === 0 && searchField.text.length > 0
+            text: "No apps found"
+        }
+
+        VerticalScrollDecorator {}
+    }
+}
diff -ruN a/usr/share/lipstick-jolla-home-qt5/eventsview/HomeFavourites.qml b/usr/share/lipstick-jolla-home-qt5/eventsview/HomeFavourites.qml
--- /dev/null
+++ b/usr/share/lipstick-jolla-home-qt5/eventsview/HomeFavourites.qml
@@ -0,0 +1,713 @@
+/*
+ * ada-home-sailfish: the Home page.
+ * - Big clock and date. Tap: opens the chosen app (default Clock /
+ *   Calendar). Long-press: choose that app.
+ * - 0-8 app slots as text (default 4). Empty slot shows "App"; tap it for a
+ *   hint, long-press any slot to choose its app. On a filled slot, typing in
+ *   the search field and tapping "Rename" renames the slot instead.
+ * - Long-press empty space: settings. Double tap empty space: display off
+ *   and lock (optional, like the stock Top menu lock button).
+ * - Swipe left/right that doesn't start at the screen edge: opens the swipe
+ *   app (default Calculator / Contacts), or switches page when set to Off. Edge
+ *   swipes stay with lipstick (HomeLayer.qml disables the mid-screen page
+ *   drag on Home).
+ * Settings live in dconf under /desktop/lipstick-jolla-home/ada_home/.
+ * License: BSD-3-Clause, see LICENSE in the ada-home-sailfish project
+ * Qt 5.6: plain ES5 JavaScript only.
+ */
+
+import QtQuick 2.6
+import Sailfish.Silica 1.0
+import Sailfish.Lipstick 1.0
+import Nemo.Configuration 1.0
+import Nemo.Notifications 1.0 as SystemNotifications
+import org.nemomobile.lipstick 0.1
+import com.jolla.lipstick 0.1
+
+Item {
+    id: root
+
+    property real statusBarHeight
+    property bool active: true
+
+    readonly property int maximumSlots: 8
+    readonly property string defaultClockApp: "/usr/share/applications/jolla-clock.desktop"
+    readonly property string defaultDateApp: "/usr/share/applications/jolla-calendar.desktop"
+    // Default swipe apps: right to left (swipe left) = Calculator,
+    // left to right (swipe right) = Contacts
+    readonly property string defaultSwipeLeftApp: "/usr/share/applications/jolla-calculator.desktop"
+    readonly property string defaultSwipeRightApp: "/usr/share/applications/jolla-contacts.desktop"
+    readonly property QtObject launcherModel: Lipstick.compositor.launcherModel
+    readonly property string _path: "/desktop/lipstick-jolla-home/ada_home/"
+
+    // "" = home, "picker" = choose an app, "settings"
+    property string view
+    // What the picker chooses for: "slot", "clock", "date", "swipeLeft", "swipeRight"
+    property string pickerTarget
+    property int pickerSlot: -1
+    readonly property bool pickerForSwipe: pickerTarget === "swipeLeft" || pickerTarget === "swipeRight"
+    // View to return to when the picker closes (Settings opens it for the swipe apps)
+    property string _returnView
+
+    // All apps (LauncherItems) sorted by name; rebuilt when the App Grid changes
+    property var launcherItems: []
+
+    readonly property int slotCount: Math.max(0, Math.min(maximumSlots, slotCountConfig.value))
+    readonly property real textScale: Math.max(0.5, Math.min(1.5, textScaleConfig.value))
+    // Margins from Settings (steps of Theme.paddingLarge, added to the default layout)
+    readonly property real sideMargin: Theme.horizontalPageMargin + marginSideConfig.value * Theme.paddingLarge
+    readonly property real topMargin: Theme.paddingLarge + marginTopConfig.value * Theme.paddingLarge
+    readonly property real bottomMargin: marginBottomConfig.value * Theme.paddingLarge
+    // Text colour (Settings): 0 ambience text colour, 1 ambience highlight
+    // colour, 2 white, 3 black. The ambience colours contrast with the ambience.
+    readonly property int colorChoice: textColorConfig.value
+    readonly property color textColor: colorChoice === 1 ? Theme.highlightColor
+                                     : colorChoice === 2 ? "white"
+                                     : colorChoice === 3 ? "black"
+                                     : Theme.primaryColor
+    readonly property color dimTextColor: colorChoice === 0 ? Theme.secondaryColor
+                                        : Qt.rgba(textColor.r, textColor.g, textColor.b, 0.75)
+    // Pressed items: the highlight colour, unless the text already uses it
+    readonly property color pressedColor: colorChoice === 1 ? Theme.primaryColor : Theme.highlightColor
+    readonly property int shadowLevel: Math.max(0, Math.min(3, shadowLevelConfig.value))
+    readonly property int textAlignment: alignmentConfig.value === 1 ? Text.AlignHCenter
+                                       : alignmentConfig.value === 2 ? Text.AlignRight
+                                       : Text.AlignLeft
+
+    function refresh() {
+        var list = []
+        if (launcherModel) {
+            for (var i = 0; ; ++i) {
+                var item = launcherModel.get(i)
+                if (!item) {
+                    break
+                }
+                if (item.entryType === "Application" && item.title.length > 0) {
+                    list.push(item)
+                }
+            }
+        }
+        list.sort(function (a, b) { return a.title.localeCompare(b.title) })
+        launcherItems = list
+    }
+
+    function findItem(path) {
+        if (!path) {
+            return null
+        }
+        for (var i = 0; i < launcherItems.length; ++i) {
+            if (launcherItems[i].filePath === path) {
+                return launcherItems[i]
+            }
+        }
+        return null
+    }
+
+    function _array(value) {
+        var result = value ? Array.prototype.slice.call(value) : []
+        while (result.length < maximumSlots) {
+            result.push("")
+        }
+        return result
+    }
+
+    // The app in slot i, or null if the slot is empty or the app is gone
+    function slotItem(i) {
+        return findItem(_array(slotAppsConfig.value)[i])
+    }
+
+    function slotLabel(i) {
+        var item = slotItem(i)
+        if (!item) {
+            return ""
+        }
+        var name = _array(slotNamesConfig.value)[i]
+        return name.length > 0 ? name : item.title
+    }
+
+    function setSlot(i, path) {
+        var apps = _array(slotAppsConfig.value)
+        var names = _array(slotNamesConfig.value)
+        apps[i] = path
+        names[i] = "" // a new app starts with its own name
+        slotAppsConfig.value = apps
+        slotNamesConfig.value = names
+    }
+
+    function renameSlot(i, name) {
+        var names = _array(slotNamesConfig.value)
+        names[i] = name
+        slotNamesConfig.value = names
+    }
+
+    function _targetConfig(target) {
+        return target === "clock" ? clockAppConfig
+             : target === "swipeLeft" ? swipeLeftConfig
+             : target === "swipeRight" ? swipeRightConfig
+             : dateAppConfig
+    }
+
+    // Name shown in Settings for a swipe app ("Off" when switched off or gone)
+    function swipeAppName(target) {
+        var value = _targetConfig(target).value
+        var item = value === "off" ? null : findItem(value)
+        return item ? item.title : "Off"
+    }
+
+    // Swipe that didn't start at the screen edge (direction: where the finger moved)
+    function swipe(direction) {
+        var value = _targetConfig(direction === "left" ? "swipeLeft" : "swipeRight").value
+        var item = value === "off" ? null : findItem(value)
+        if (item) {
+            launch(item)
+        } else {
+            // Off (or app gone): switch page like the stock mid-screen swipe
+            Lipstick.compositor.homeLayer.setCurrentItem(Lipstick.compositor.switcherLayer, true, direction)
+        }
+    }
+
+    // Swipe detection, used by the empty space, the clock, the date and the slots.
+    // Starts within edgeWidth of the screen edge are left alone (lipstick's edge swipes).
+    property real _swipeX
+    property real _swipeY
+    property double _swipeTime
+    property bool swiped
+
+    function swipeBegin(item, mouse) {
+        var p = item.mapToItem(root, mouse.x, mouse.y)
+        _swipeX = p.x
+        _swipeY = p.y
+        _swipeTime = Date.now()
+        swiped = false
+    }
+
+    // Returns true if this release finished a swipe (then don't treat it as a tap)
+    function swipeEnd(item, mouse) {
+        var p = item.mapToItem(root, mouse.x, mouse.y)
+        var dx = p.x - _swipeX
+        var dy = p.y - _swipeY
+        var edgeWidth = Theme.paddingLarge * 2
+        if (_swipeX < edgeWidth || _swipeX > width - edgeWidth
+                || Math.abs(dx) < Theme.itemSizeSmall
+                || Math.abs(dx) < 2 * Math.abs(dy)
+                || Date.now() - _swipeTime > 1000) {
+            return false
+        }
+        swiped = true
+        swipe(dx < 0 ? "left" : "right")
+        return true
+    }
+
+    // The app the clock or the date opens: the chosen one if it is still
+    // installed, otherwise the stock app
+    function targetItem(target) {
+        return findItem(_targetConfig(target).value)
+                || findItem(target === "clock" ? defaultClockApp : defaultDateApp)
+    }
+
+    function launch(item) {
+        if (item && Desktop.instance && Desktop.instance.switcher) {
+            Desktop.instance.switcher.activateWindowFor(item)
+        }
+    }
+
+    function openPicker(target, slot) {
+        _returnView = view === "settings" ? "settings" : ""
+        refresh()
+        pickerTarget = target
+        pickerSlot = slot === undefined ? -1 : slot
+        view = "picker"
+        picker.open()
+    }
+
+    function openSettings() {
+        settingsOpenedConfig.value = true
+        view = "settings"
+    }
+
+    function closeView() {
+        picker.close()
+        view = _returnView
+        _returnView = ""
+    }
+
+    function showHint(text) {
+        hint.body = text
+        hint.previewBody = text
+        hint.publish()
+    }
+
+    // Old multi-select favourites (v0.2.0) become the first slots, once
+    function _migrate() {
+        if (migratedConfig.value) {
+            return
+        }
+        var old = favouritesConfig.value ? Array.prototype.slice.call(favouritesConfig.value) : []
+        if (old.length > 0) {
+            var apps = _array([])
+            for (var i = 0; i < old.length && i < maximumSlots; ++i) {
+                apps[i] = old[i]
+            }
+            slotAppsConfig.value = apps
+            slotCountConfig.value = Math.max(4, Math.min(maximumSlots, old.length))
+        }
+        migratedConfig.value = true
+    }
+
+    onActiveChanged: if (!active) closeView()
+    onLauncherModelChanged: refresh()
+    Component.onCompleted: {
+        _migrate()
+        refresh()
+        _statusClock = _findClock(_statusBar)
+        _statusAlarmBell = _findAlarmBell(_statusBar)
+    }
+
+    ConfigurationValue { id: slotAppsConfig; key: root._path + "slot_apps"; defaultValue: [] }
+    ConfigurationValue { id: slotNamesConfig; key: root._path + "slot_names"; defaultValue: [] }
+    ConfigurationValue { id: slotCountConfig; key: root._path + "slot_count"; defaultValue: 4 }
+    ConfigurationValue { id: clockAppConfig; key: root._path + "clock_app"; defaultValue: "" }
+    ConfigurationValue { id: dateAppConfig; key: root._path + "date_app"; defaultValue: "" }
+    ConfigurationValue { id: dateTimeConfig; key: root._path + "date_time"; defaultValue: 1 }
+    ConfigurationValue { id: alignmentConfig; key: root._path + "alignment"; defaultValue: 0 }
+    ConfigurationValue { id: bottomConfig; key: root._path + "bottom"; defaultValue: false }
+    ConfigurationValue { id: textScaleConfig; key: root._path + "text_scale"; defaultValue: 1.0 }
+    ConfigurationValue { id: boldConfig; key: root._path + "bold"; defaultValue: false }
+    ConfigurationValue { id: autoKeyboardConfig; key: root._path + "auto_keyboard"; defaultValue: true }
+    ConfigurationValue { id: shadowLevelConfig; key: root._path + "shadow_level"; defaultValue: 1 }
+    ConfigurationValue { id: textColorConfig; key: root._path + "text_color"; defaultValue: 0 }
+    ConfigurationValue { id: swipeLeftConfig; key: root._path + "swipe_left_app"; defaultValue: root.defaultSwipeLeftApp }
+    ConfigurationValue { id: swipeRightConfig; key: root._path + "swipe_right_app"; defaultValue: root.defaultSwipeRightApp }
+    ConfigurationValue { id: doubleTapLockConfig; key: root._path + "double_tap_lock"; defaultValue: false }
+    ConfigurationValue { id: hideStatusBarConfig; key: root._path + "hide_status_bar"; defaultValue: false }
+    ConfigurationValue { id: hideAlarmBellConfig; key: root._path + "hide_alarm_bell"; defaultValue: false }
+    ConfigurationValue { id: appsGapConfig; key: root._path + "apps_gap"; defaultValue: 0 }
+    ConfigurationValue { id: marginSideConfig; key: root._path + "margin_side"; defaultValue: 0 }
+    ConfigurationValue { id: marginTopConfig; key: root._path + "margin_top"; defaultValue: 0 }
+    ConfigurationValue { id: marginBottomConfig; key: root._path + "margin_bottom"; defaultValue: 0 }
+    ConfigurationValue { id: settingsOpenedConfig; key: root._path + "settings_opened"; defaultValue: false }
+    ConfigurationValue { id: migratedConfig; key: root._path + "migrated_favourites"; defaultValue: false }
+    ConfigurationValue { id: favouritesConfig; key: root._path + "favourites"; defaultValue: [] }
+
+    Connections {
+        target: root.launcherModel
+        ignoreUnknownSignals: true
+        onRowsInserted: root.refresh()
+        onRowsRemoved: root.refresh()
+        onModelReset: root.refresh()
+    }
+
+    SystemNotifications.Notification {
+        id: hint
+
+        isTransient: true
+        appIcon: "icon-lock-information"
+    }
+
+    // The status bar on Home: our text colour and no clock (Home has its own).
+    // Done from here so that no status bar file is changed and status bar
+    // patches still apply. If a patch rebuilds the status bar so the clock
+    // can't be found, the clock simply stays visible.
+    readonly property Item _statusBar: !!Lipstick.compositor && !!Lipstick.compositor.homeLayer
+                                       ? Lipstick.compositor.homeLayer.statusBar : null
+    readonly property bool _homeShown: !!Lipstick.compositor && Lipstick.compositor.homeActive
+                                       && Lipstick.compositor.homeLayer.currentItem === Lipstick.compositor.eventsLayer
+    property Item _statusClock
+    property Item _statusAlarmBell
+
+    // The alarm indicator: an Icon showing image://theme/icon-status-alarm
+    function _findAlarmBell(item) {
+        if (!item) {
+            return null
+        }
+        if (item.hasOwnProperty("source") && String(item.source).indexOf("icon-status-alarm") !== -1) {
+            return item
+        }
+        for (var i = 0; i < item.children.length; ++i) {
+            var found = _findAlarmBell(item.children[i])
+            if (found) {
+                return found
+            }
+        }
+        return null
+    }
+
+    // Settings: Hide alarm bell. Everywhere this status bar is shown; the
+    // active alarms are listed on the covers page instead.
+    Binding {
+        target: root._statusAlarmBell
+        property: "visible"
+        value: false
+        when: !!root._statusAlarmBell && hideAlarmBellConfig.value
+    }
+
+    function _findClock(item) {
+        if (!item) {
+            return null
+        }
+        // ClockItem (Sailfish.Lipstick): has updatesEnabled, time and forceUpdate()
+        if (item.hasOwnProperty("updatesEnabled") && item.hasOwnProperty("time")
+                && typeof item.forceUpdate === "function") {
+            return item
+        }
+        for (var i = 0; i < item.children.length; ++i) {
+            var found = _findClock(item.children[i])
+            if (found) {
+                return found
+            }
+        }
+        return null
+    }
+
+    on_HomeShownChanged: {
+        if (_homeShown && !_statusClock) {
+            _statusClock = _findClock(_statusBar)
+        }
+        if (_homeShown && !_statusAlarmBell) {
+            _statusAlarmBell = _findAlarmBell(_statusBar)
+        }
+        if (!_homeShown) {
+            _statusRevealed = false
+        }
+    }
+    on_StatusBarChanged: {
+        _statusClock = _findClock(_statusBar)
+        _statusAlarmBell = _findAlarmBell(_statusBar)
+    }
+
+    Binding {
+        target: root._statusBar
+        property: "color"
+        value: root.textColor
+        when: !!root._statusBar && root._homeShown
+    }
+
+    Binding {
+        target: root._statusClock
+        property: "opacity"
+        value: 0
+        when: !!root._statusClock && root._homeShown
+    }
+
+    // Settings: Hide status bar. On Home the status bar is invisible and
+    // fades in while Home is touched, then out again about 3 s after release.
+    // Only its opacity is changed, so status bar patches keep control of the rest.
+    property bool _statusRevealed
+    property real _statusBarOpacity: _statusRevealed ? 1 : 0
+    // FadeAnimation only animates "opacity" unless told otherwise, so be explicit
+    Behavior on _statusBarOpacity {
+        NumberAnimation {
+            duration: root._statusRevealed ? 250 : 600
+            easing.type: Easing.InOutQuad
+        }
+    }
+
+    function revealStatusBar(keep) {
+        _statusRevealed = true
+        if (keep) {
+            statusHideTimer.stop()
+        } else {
+            statusHideTimer.restart()
+        }
+    }
+
+    Timer {
+        id: statusHideTimer
+        interval: 3000
+        onTriggered: root._statusRevealed = false
+    }
+
+    Binding {
+        target: root._statusBar
+        property: "opacity"
+        value: root._statusBarOpacity
+        when: !!root._statusBar && root._homeShown && hideStatusBarConfig.value
+    }
+
+    // x for an item of width w, following the alignment setting
+    function alignedX(w) {
+        if (textAlignment === Text.AlignHCenter) {
+            return (width - w) / 2
+        } else if (textAlignment === Text.AlignRight) {
+            return width - w - sideMargin + Theme.paddingMedium
+        }
+        return sideMargin - Theme.paddingMedium
+    }
+
+    // Home view. One touch area handles everything (tap, long-press, double
+    // tap, swipe) and works out what is under the finger. Separate touch
+    // items per app would cancel the press as soon as the finger moves, so a
+    // swipe starting on an app or the clock would get lost.
+    MouseArea {
+        id: homeArea
+
+        // What was pressed: "" (empty space), "clock", "date" or "slot<n>"
+        property string pressedTarget
+        // The finger moved beyond the drag threshold: no tap, no long-press
+        property bool moved
+
+        function _hit(item, x, y) {
+            var p = homeArea.mapToItem(item, x, y)
+            return item.visible && p.x >= 0 && p.y >= 0 && p.x < item.width && p.y < item.height
+        }
+
+        function targetAt(x, y) {
+            if (clockColumn.visible) {
+                if (_hit(clockButton, x, y)) {
+                    return "clock"
+                }
+                if (_hit(dateButton, x, y)) {
+                    return "date"
+                }
+            }
+            for (var i = 0; i < slotRepeater.count; ++i) {
+                var item = slotRepeater.itemAt(i)
+                if (item && _hit(item, x, y)) {
+                    return "slot" + i
+                }
+            }
+            return ""
+        }
+
+        function isPressed(target) {
+            return pressed && !moved && pressedTarget === target
+        }
+
+        anchors.fill: parent
+        // In Settings the clock and date stay visible as a live preview
+        visible: root.view === "" || root.view === "settings"
+        enabled: root.view === ""
+
+        onPressed: {
+            root.revealStatusBar(true)
+            root.swipeBegin(homeArea, mouse)
+            moved = false
+            pressedTarget = targetAt(mouse.x, mouse.y)
+        }
+        onPositionChanged: {
+            if (!moved && (Math.abs(mouse.x - root._swipeX) > Theme.startDragDistance
+                           || Math.abs(mouse.y - root._swipeY) > Theme.startDragDistance)) {
+                moved = true
+            }
+        }
+        onReleased: {
+            root.revealStatusBar(false)
+            root.swipeEnd(homeArea, mouse)
+        }
+        onCanceled: {
+            moved = true
+            root.revealStatusBar(false)
+        }
+
+        onClicked: {
+            if (root.swiped || moved) {
+                return
+            }
+            if (pressedTarget === "clock" || pressedTarget === "date") {
+                root.launch(root.targetItem(pressedTarget))
+            } else if (pressedTarget.indexOf("slot") === 0) {
+                var item = root.slotItem(parseInt(pressedTarget.substring(4)))
+                if (item) {
+                    root.launch(item)
+                } else {
+                    root.showHint("Long press to select app")
+                }
+            }
+        }
+        onPressAndHold: {
+            if (moved) {
+                return
+            }
+            if (pressedTarget === "clock" || pressedTarget === "date") {
+                root.openPicker(pressedTarget)
+            } else if (pressedTarget.indexOf("slot") === 0) {
+                root.openPicker("slot", parseInt(pressedTarget.substring(4)))
+            } else {
+                root.openSettings()
+            }
+        }
+        // Same as the stock Top menu lock button: display off, then the
+        // device locks according to the normal lock settings
+        onDoubleClicked: {
+            if (pressedTarget === "" && doubleTapLockConfig.value) {
+                Lipstick.compositor.setDisplayOff()
+            }
+        }
+
+        Column {
+            id: clockColumn
+
+            y: root.statusBarHeight + root.topMargin
+            width: parent.width
+            visible: dateTimeConfig.value !== 0
+            layer.enabled: root.shadowLevel > 0
+            layer.effect: HomeTextShadow { level: root.shadowLevel; textColor: root.textColor }
+
+            Item {
+                id: clockButton
+
+                x: root.alignedX(width)
+                width: clock.width + 2 * Theme.paddingMedium
+                height: visible ? clock.height : 0
+                visible: dateTimeConfig.value === 1
+
+                ClockItem {
+                    id: clock
+
+                    x: Theme.paddingMedium
+                    updatesEnabled: root.active
+                    color: homeArea.isPressed("clock") ? root.pressedColor : root.textColor
+                    font.pixelSize: Theme.fontSizeHuge * 1.5 * root.textScale
+                    font.bold: boldConfig.value
+                }
+            }
+
+            Item {
+                id: dateButton
+
+                x: root.alignedX(width)
+                width: dateLabel.width + 2 * Theme.paddingMedium
+                height: dateLabel.height + 2 * Theme.paddingSmall
+
+                Label {
+                    id: dateLabel
+
+                    x: Theme.paddingMedium
+                    y: Theme.paddingSmall
+                    text: Qt.formatDate(clock.time, "ddd, d MMM")
+                    color: homeArea.isPressed("date") ? root.pressedColor : root.dimTextColor
+                    font.pixelSize: Theme.fontSizeMedium * root.textScale
+                    font.bold: boldConfig.value
+                }
+            }
+        }
+
+        Column {
+            id: slotsColumn
+
+            readonly property real contentTop: clockColumn.visible ? clockColumn.y + clockColumn.height
+                                                                   : root.statusBarHeight + root.topMargin
+            readonly property real contentBottom: parent.height - root.bottomMargin
+
+            width: parent.width
+            visible: root.view === ""
+            layer.enabled: root.shadowLevel > 0
+            layer.effect: HomeTextShadow { level: root.shadowLevel; textColor: root.textColor }
+            // Bottom: aligned to the bottom margin. Otherwise a fixed distance
+            // below the clock (Settings: clock to apps distance), or "Auto":
+            // centred between the clock and the bottom margin
+            y: bottomConfig.value
+               ? Math.max(contentTop, contentBottom - height - Theme.itemSizeLarge)
+               : appsGapConfig.value > 0
+                 ? contentTop + appsGapConfig.value * Theme.paddingLarge
+                 : Math.max(contentTop + Theme.paddingLarge, contentTop + (contentBottom - contentTop - height) / 2)
+
+            Repeater {
+                id: slotRepeater
+
+                model: root.slotCount
+
+                delegate: Item {
+                    id: slot
+
+                    readonly property string label: (root.launcherItems, slotAppsConfig.value,
+                                                      slotNamesConfig.value, root.slotLabel(index))
+
+                    width: slotsColumn.width
+                    height: slotText.height + 2 * Theme.paddingMedium
+
+                    Label {
+                        id: slotText
+
+                        x: root.sideMargin
+                        width: parent.width - 2 * root.sideMargin
+                        anchors.verticalCenter: parent.verticalCenter
+                        horizontalAlignment: root.textAlignment
+                        text: slot.label.length > 0 ? slot.label : "App"
+                        color: homeArea.isPressed("slot" + index) ? root.pressedColor
+                             : slot.label.length > 0 ? root.textColor
+                             : Qt.rgba(root.dimTextColor.r, root.dimTextColor.g, root.dimTextColor.b, Theme.opacityLow)
+                        font.pixelSize: Theme.fontSizeLarge * root.textScale
+                        font.bold: boldConfig.value
+                        truncationMode: TruncationMode.Fade
+                    }
+                }
+            }
+        }
+
+        // First-run tip, until Settings has been opened once
+        Label {
+            visible: !settingsOpenedConfig.value && root.view === ""
+            anchors {
+                bottom: parent.bottom
+                bottomMargin: Theme.paddingLarge * 2
+                horizontalCenter: parent.horizontalCenter
+            }
+            width: parent.width - 2 * Theme.horizontalPageMargin
+            horizontalAlignment: Text.AlignHCenter
+            wrapMode: Text.Wrap
+            text: "Long press anywhere for settings"
+            color: root.dimTextColor
+            font.pixelSize: Theme.fontSizeSmall
+        }
+    }
+
+    HomeAppPicker {
+        id: picker
+
+        anchors.fill: parent
+        visible: root.view === "picker"
+        topMargin: root.statusBarHeight
+        items: root.launcherItems
+        autoKeyboard: autoKeyboardConfig.value
+        title: root.pickerTarget === "clock" ? "App for the clock"
+             : root.pickerTarget === "date" ? "App for the date"
+             : root.pickerTarget === "swipeLeft" ? "Swipe left app"
+             : root.pickerTarget === "swipeRight" ? "Swipe right app"
+             : "Select an app"
+        showDefault: root.pickerTarget !== "slot"
+        defaultLabel: root.pickerTarget === "clock" ? "Default (Clock)"
+                    : root.pickerTarget === "date" ? "Default (Calendar)"
+                    : "Off (swipe switches the page)"
+        defaultSelected: showDefault && (root.pickerForSwipe
+                                         ? root._targetConfig(root.pickerTarget).value === "off"
+                                         : !root._targetConfig(root.pickerTarget).value)
+        selectedPath: root.pickerTarget === "slot"
+                      ? (slotAppsConfig.value, root._array(slotAppsConfig.value)[root.pickerSlot] || "")
+                      : (root._targetConfig(root.pickerTarget).value || "")
+        // Rename only for a slot that already has an app
+        renameAllowed: root.pickerTarget === "slot" && root.pickerSlot >= 0
+                       && (slotAppsConfig.value, root.slotItem(root.pickerSlot) !== null)
+
+        onPicked: {
+            if (root.pickerTarget === "slot") {
+                root.setSlot(root.pickerSlot, path)
+            } else {
+                root._targetConfig(root.pickerTarget).value = path
+            }
+            root.closeView()
+        }
+        onDefaultPicked: {
+            root._targetConfig(root.pickerTarget).value = root.pickerForSwipe ? "off" : ""
+            root.closeView()
+        }
+        onRenamed: {
+            root.renameSlot(root.pickerSlot, name)
+            root.closeView()
+        }
+        // Cancel keeps the previous choice
+        onCancelled: root.closeView()
+    }
+
+    HomeSettings {
+        anchors.fill: parent
+        visible: root.view === "settings"
+        // Below the clock and date, which stay visible as a live preview
+        topMargin: clockColumn.visible ? clockColumn.y + clockColumn.height + Theme.paddingSmall
+                                       : root.statusBarHeight
+        swipeLeftName: (root.launcherItems, swipeLeftConfig.value, root.swipeAppName("swipeLeft"))
+        swipeRightName: (root.launcherItems, swipeRightConfig.value, root.swipeAppName("swipeRight"))
+        onPickApp: root.openPicker(target)
+        onDone: root.closeView()
+    }
+}
diff -ruN a/usr/share/lipstick-jolla-home-qt5/eventsview/HomeSettingsChoice.qml b/usr/share/lipstick-jolla-home-qt5/eventsview/HomeSettingsChoice.qml
--- /dev/null
+++ b/usr/share/lipstick-jolla-home-qt5/eventsview/HomeSettingsChoice.qml
@@ -0,0 +1,43 @@
+/*
+ * ada-home-sailfish: settings row "label   value"; tap cycles through the
+ * choices. The value sits in the shared input column (valueX) so it isn't
+ * mistaken for a right-aligned section title.
+ * License: BSD-3-Clause, see LICENSE in the ada-home-sailfish project
+ */
+
+import QtQuick 2.6
+import Sailfish.Silica 1.0
+
+BackgroundItem {
+    id: choice
+
+    property string label
+    property var choices: []      // texts, index = value
+    property int value
+    property real valueX: width * 0.55
+
+    signal chosen(int newValue)
+
+    width: parent ? parent.width : 0
+    height: Math.max(Theme.itemSizeSmall, nameLabel.height + 2 * Theme.paddingSmall)
+    onClicked: chosen((value + 1) % choices.length)
+
+    Label {
+        id: nameLabel
+
+        x: Theme.horizontalPageMargin
+        width: choice.valueX - x - Theme.paddingLarge
+        anchors.verticalCenter: parent.verticalCenter
+        text: choice.label
+        wrapMode: Text.Wrap
+    }
+
+    Label {
+        x: choice.valueX
+        width: parent.width - x - Theme.horizontalPageMargin
+        anchors.verticalCenter: parent.verticalCenter
+        text: choice.choices.length > 0 ? choice.choices[Math.max(0, Math.min(choice.choices.length - 1, choice.value))] : ""
+        color: Theme.highlightColor
+        truncationMode: TruncationMode.Fade
+    }
+}
diff -ruN a/usr/share/lipstick-jolla-home-qt5/eventsview/HomeSettings.qml b/usr/share/lipstick-jolla-home-qt5/eventsview/HomeSettings.qml
--- /dev/null
+++ b/usr/share/lipstick-jolla-home-qt5/eventsview/HomeSettings.qml
@@ -0,0 +1,258 @@
+/*
+ * ada-home-sailfish: Home settings (opened by long-pressing empty space).
+ * Values live in dconf under /desktop/lipstick-jolla-home/ada_home/
+ * (the same keys HomeFavourites.qml reads).
+ * License: BSD-3-Clause, see LICENSE in the ada-home-sailfish project
+ */
+
+import QtQuick 2.6
+import Sailfish.Silica 1.0
+import Nemo.Configuration 1.0
+
+Item {
+    id: settings
+
+    property real topMargin
+
+    property string swipeLeftName
+    property string swipeRightName
+
+    signal done()
+    signal pickApp(string target)
+
+    readonly property string _path: "/desktop/lipstick-jolla-home/ada_home/"
+
+    ConfigurationValue { id: slotCount; key: settings._path + "slot_count"; defaultValue: 4 }
+    ConfigurationValue { id: dateTime; key: settings._path + "date_time"; defaultValue: 1 }
+    ConfigurationValue { id: alignment; key: settings._path + "alignment"; defaultValue: 0 }
+    ConfigurationValue { id: bottom; key: settings._path + "bottom"; defaultValue: false }
+    ConfigurationValue { id: textScale; key: settings._path + "text_scale"; defaultValue: 1.0 }
+    ConfigurationValue { id: bold; key: settings._path + "bold"; defaultValue: false }
+    ConfigurationValue { id: autoKeyboard; key: settings._path + "auto_keyboard"; defaultValue: true }
+    ConfigurationValue { id: shadowLevel; key: settings._path + "shadow_level"; defaultValue: 1 }
+    ConfigurationValue { id: textColor; key: settings._path + "text_color"; defaultValue: 0 }
+    ConfigurationValue { id: doubleTapLock; key: settings._path + "double_tap_lock"; defaultValue: false }
+    ConfigurationValue { id: hideStatusBar; key: settings._path + "hide_status_bar"; defaultValue: false }
+    ConfigurationValue { id: hideAlarmBell; key: settings._path + "hide_alarm_bell"; defaultValue: false }
+    ConfigurationValue { id: weatherHeader; key: settings._path + "weather_header"; defaultValue: true }
+    ConfigurationValue { id: smallCovers; key: settings._path + "small_covers"; defaultValue: true }
+    ConfigurationValue { id: appsGap; key: settings._path + "apps_gap"; defaultValue: 0 }
+    ConfigurationValue { id: marginSide; key: settings._path + "margin_side"; defaultValue: 0 }
+    ConfigurationValue { id: marginTop; key: settings._path + "margin_top"; defaultValue: 0 }
+    ConfigurationValue { id: marginBottom; key: settings._path + "margin_bottom"; defaultValue: 0 }
+
+    // Readable on any wallpaper: the ambience's dimmer colour behind the content
+    Rectangle {
+        anchors {
+            top: header.top
+            bottom: parent.bottom
+            left: parent.left
+            right: parent.right
+        }
+        color: Theme.rgba(Theme.highlightDimmerColor, 0.8)
+    }
+
+    Item {
+        id: header
+
+        y: settings.topMargin
+        width: parent.width
+        height: Theme.itemSizeMedium
+
+        Label {
+            anchors {
+                left: parent.left
+                leftMargin: Theme.horizontalPageMargin
+                verticalCenter: parent.verticalCenter
+            }
+            text: "Settings"
+            color: Theme.highlightColor
+            font.pixelSize: Theme.fontSizeLarge
+        }
+
+        Button {
+            anchors {
+                right: parent.right
+                rightMargin: Theme.horizontalPageMargin
+                verticalCenter: parent.verticalCenter
+            }
+            preferredWidth: Theme.buttonWidthExtraSmall
+            text: "Done"
+            onClicked: settings.done()
+        }
+    }
+
+    SilicaFlickable {
+        anchors {
+            top: header.bottom
+            bottom: parent.bottom
+            left: parent.left
+            right: parent.right
+        }
+        clip: true
+        contentHeight: column.height + Theme.paddingLarge
+
+        Column {
+            id: column
+
+            width: parent.width
+
+            SectionHeader { text: "Home screen" }
+
+            HomeSettingsStepper {
+                label: "Apps on home screen"
+                value: slotCount.value
+                maximum: 8
+                onStepped: slotCount.value = newValue
+            }
+
+            HomeSettingsChoice {
+                label: "Show date time"
+                // Stored values: 0 = off, 1 = clock and date, 2 = date only
+                choices: ["Off", "On", "Date only"]
+                value: dateTime.value
+                onChosen: dateTime.value = newValue
+            }
+
+
+            HomeSettingsChoice {
+                label: "App alignment"
+                choices: ["Left", "Center", "Right"]
+                value: alignment.value
+                onChosen: alignment.value = newValue
+            }
+
+
+            SectionHeader { text: "Layout" }
+
+            HomeSettingsSwitch {
+                label: "Apps at the bottom"
+                checked: bottom.value
+                onToggled: bottom.value = !bottom.value
+            }
+
+            // Margins in steps of Theme.paddingLarge, added to the default layout
+            HomeSettingsStepper {
+                label: "Side margin"
+                value: marginSide.value
+                maximum: 10
+                onStepped: marginSide.value = newValue
+            }
+
+            HomeSettingsStepper {
+                label: "Top margin"
+                value: marginTop.value
+                maximum: 20
+                onStepped: marginTop.value = newValue
+            }
+
+            HomeSettingsStepper {
+                label: "Clock to apps distance"
+                value: appsGap.value
+                maximum: 20
+                minimumText: "Auto"
+                onStepped: appsGap.value = newValue
+            }
+
+            HomeSettingsStepper {
+                label: "Bottom margin"
+                value: marginBottom.value
+                maximum: 20
+                onStepped: marginBottom.value = newValue
+            }
+
+            HomeSettingsSwitch {
+                label: "Always small covers"
+                description: "Running apps 3 per row, also with only a few apps"
+                checked: smallCovers.value
+                onToggled: smallCovers.value = !smallCovers.value
+            }
+
+            HomeSettingsSwitch {
+                label: "Weather header"
