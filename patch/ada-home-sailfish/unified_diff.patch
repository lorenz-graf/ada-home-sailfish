diff -ruN a/usr/share/lipstick-jolla-home-qt5/eventsview/HomeFavourites.qml b/usr/share/lipstick-jolla-home-qt5/eventsview/HomeFavourites.qml
--- /dev/null
+++ b/usr/share/lipstick-jolla-home-qt5/eventsview/HomeFavourites.qml
@@ -0,0 +1,419 @@
+/*
+ * ada-home-sailfish: the Home page. Big clock and date, then up to eight
+ * favourite apps as plain text.
+ * - Tap the clock / the date: opens the chosen app (default: Clock / Calendar)
+ * - Long-press the clock / the date: choose that app
+ * - Long-press empty space or a favourite: choose the favourites
+ * License: BSD-3-Clause, see LICENSE in the ada-home-sailfish project
+ */
+
+import QtQuick 2.6
+import Sailfish.Silica 1.0
+import Sailfish.Lipstick 1.0
+import Nemo.Configuration 1.0
+import org.nemomobile.lipstick 0.1
+import com.jolla.lipstick 0.1
+
+Item {
+    id: root
+
+    property real statusBarHeight
+    property bool active: true
+
+    readonly property int maximumFavourites: 8
+    readonly property string defaultClockApp: "/usr/share/applications/jolla-clock.desktop"
+    readonly property string defaultDateApp: "/usr/share/applications/jolla-calendar.desktop"
+    readonly property QtObject launcherModel: Lipstick.compositor.launcherModel
+
+    // "" = no picker, "favourites" = choose favourites,
+    // "clock" / "date" = choose the app opened by the clock / the date
+    property string pickerMode
+    readonly property bool singlePick: pickerMode === "clock" || pickerMode === "date"
+    // LauncherItems of the favourites, in the chosen order
+    property var favouriteItems: []
+    // All apps for the picker, sorted by name
+    property var allItems: []
+
+    function _launcherItems() {
+        var list = []
+        if (!launcherModel) {
+            return list
+        }
+        for (var i = 0; ; ++i) {
+            var item = launcherModel.get(i)
+            if (!item) {
+                break
+            }
+            if (item.entryType === "Application" && item.title.length > 0) {
+                list.push(item)
+            }
+        }
+        return list
+    }
+
+    function _findItem(items, path) {
+        for (var i = 0; i < items.length; ++i) {
+            if (items[i].filePath === path) {
+                return items[i]
+            }
+        }
+        return null
+    }
+
+    function _paths() {
+        var value = favouritesConfig.value
+        return value ? Array.prototype.slice.call(value) : []
+    }
+
+    function _targetConfig(mode) {
+        return mode === "clock" ? clockAppConfig : dateAppConfig
+    }
+
+    function _defaultApp(mode) {
+        return mode === "clock" ? defaultClockApp : defaultDateApp
+    }
+
+    function refresh() {
+        var items = _launcherItems()
+        var result = []
+        var paths = _paths()
+        for (var i = 0; i < paths.length; ++i) {
+            var item = _findItem(items, paths[i])
+            if (item) {
+                result.push(item)
+            }
+        }
+        favouriteItems = result
+        if (pickerMode !== "") {
+            items.sort(function (a, b) { return a.title.localeCompare(b.title) })
+            allItems = items
+        }
+    }
+
+    function isFavourite(path) {
+        return _paths().indexOf(path) !== -1
+    }
+
+    function toggleFavourite(path) {
+        var paths = _paths()
+        var index = paths.indexOf(path)
+        if (index !== -1) {
+            paths.splice(index, 1)
+        } else if (paths.length < maximumFavourites) {
+            paths.push(path)
+        }
+        favouritesConfig.value = paths
+    }
+
+    // The app the clock or the date opens: the chosen one if it is still
+    // installed, otherwise the stock app
+    function targetItem(mode) {
+        var items = _launcherItems()
+        var chosen = _targetConfig(mode).value
+        return (chosen && _findItem(items, chosen)) || _findItem(items, _defaultApp(mode))
+    }
+
+    function chooseTarget(path) {
+        _targetConfig(pickerMode).value = path
+        pickerMode = ""
+    }
+
+    function launch(item) {
+        if (item && Desktop.instance && Desktop.instance.switcher) {
+            Desktop.instance.switcher.activateWindowFor(item)
+        }
+    }
+
+    function openPicker(mode) {
+        pickerMode = mode
+        refresh()
+        pickerList.positionViewAtBeginning()
+    }
+
+    onPickerModeChanged: if (pickerMode === "") allItems = []
+    onActiveChanged: if (!active) pickerMode = ""
+    onLauncherModelChanged: refresh()
+    Component.onCompleted: refresh()
+
+    ConfigurationValue {
+        id: favouritesConfig
+
+        key: "/desktop/lipstick-jolla-home/ada_home/favourites"
+        defaultValue: []
+        onValueChanged: root.refresh()
+    }
+
+    ConfigurationValue {
+        id: clockAppConfig
+
+        key: "/desktop/lipstick-jolla-home/ada_home/clock_app"
+        defaultValue: ""
+    }
+
+    ConfigurationValue {
+        id: dateAppConfig
+
+        key: "/desktop/lipstick-jolla-home/ada_home/date_app"
+        defaultValue: ""
+    }
+
+    Connections {
+        target: root.launcherModel
+        ignoreUnknownSignals: true
+        onRowsInserted: root.refresh()
+        onRowsRemoved: root.refresh()
+        onModelReset: root.refresh()
+    }
+
+    // Normal view: clock, date and favourites
+    MouseArea {
+        id: homeArea
+
+        anchors.fill: parent
+        visible: root.pickerMode === ""
+        onPressAndHold: root.openPicker("favourites")
+
+        BackgroundItem {
+            id: clockButton
+
+            x: Theme.horizontalPageMargin - Theme.paddingMedium
+            y: root.statusBarHeight + Theme.paddingLarge
+            width: clock.width + 2 * Theme.paddingMedium
+            height: clock.height
+            highlightedColor: "transparent"
+            onClicked: root.launch(root.targetItem("clock"))
+            onPressAndHold: root.openPicker("clock")
+
+            ClockItem {
+                id: clock
+
+                x: Theme.paddingMedium
+                updatesEnabled: root.active
+                color: clockButton.highlighted ? Theme.highlightColor : Theme.primaryColor
+                font.pixelSize: Theme.fontSizeHuge * 1.5
+            }
+        }
+
+        BackgroundItem {
+            id: dateButton
+
+            anchors {
+                left: clockButton.left
+                top: clockButton.bottom
+            }
+            width: dateLabel.width + 2 * Theme.paddingMedium
+            height: dateLabel.height + 2 * Theme.paddingSmall
+            highlightedColor: "transparent"
+            onClicked: root.launch(root.targetItem("date"))
+            onPressAndHold: root.openPicker("date")
+
+            Label {
+                id: dateLabel
+
+                x: Theme.paddingMedium
+                y: Theme.paddingSmall
+                text: Qt.formatDate(clock.time, "dddd, d MMMM")
+                color: dateButton.highlighted ? Theme.highlightColor : Theme.secondaryColor
+                font.pixelSize: Theme.fontSizeMedium
+            }
+        }
+
+        Column {
+            id: favouritesColumn
+
+            anchors {
+                left: parent.left
+                right: parent.right
+                verticalCenter: parent.verticalCenter
+                verticalCenterOffset: (dateButton.y + dateButton.height) / 2
+            }
+
+            Repeater {
+                model: root.favouriteItems
+
+                delegate: BackgroundItem {
+                    id: favourite
+
+                    width: favouritesColumn.width
+                    height: Theme.itemSizeMedium
+                    highlightedColor: "transparent"
+                    onClicked: root.launch(modelData)
+                    onPressAndHold: root.openPicker("favourites")
+
+                    Label {
+                        x: Theme.horizontalPageMargin
+                        width: parent.width - 2 * Theme.horizontalPageMargin
+                        anchors.verticalCenter: parent.verticalCenter
+                        text: modelData.title
+                        color: favourite.highlighted ? Theme.highlightColor : Theme.primaryColor
+                        font.pixelSize: Theme.fontSizeLarge
+                        truncationMode: TruncationMode.Fade
+                    }
+                }
+            }
+
+            Label {
+                visible: root.favouriteItems.length === 0
+                x: Theme.horizontalPageMargin
+                width: parent.width - 2 * Theme.horizontalPageMargin
+                wrapMode: Text.Wrap
+                text: "Long-press to choose your favourite apps"
+                color: Theme.secondaryHighlightColor
+                font.pixelSize: Theme.fontSizeMedium
+            }
+        }
+    }
+
+    // Picker: all apps. Favourites: tap to add or remove.
+    // Clock / date: tap one app (or "Default") to choose it.
+    Item {
+        anchors.fill: parent
+        visible: root.pickerMode !== ""
+
+        Item {
+            id: pickerHeader
+
+            y: root.statusBarHeight
+            width: parent.width
+            height: Theme.itemSizeMedium
+
+            Label {
+                anchors {
+                    left: parent.left
+                    leftMargin: Theme.horizontalPageMargin
+                    right: doneButton.left
+                    verticalCenter: parent.verticalCenter
+                }
+                text: root.pickerMode === "clock" ? "App for the clock"
+                    : root.pickerMode === "date" ? "App for the date"
+                    : "Favourites " + root.favouriteItems.length + "/" + root.maximumFavourites
+                color: Theme.highlightColor
+                font.pixelSize: Theme.fontSizeLarge
+                truncationMode: TruncationMode.Fade
+            }
+
+            Button {
+                id: doneButton
+
+                anchors {
+                    right: parent.right
+                    rightMargin: Theme.horizontalPageMargin
+                    verticalCenter: parent.verticalCenter
+                }
+                preferredWidth: Theme.buttonWidthExtraSmall
+                // Cancelling a clock/date choice keeps the previous app
+                text: root.singlePick ? "Cancel" : "Done"
+                onClicked: root.pickerMode = ""
+            }
+        }
+
+        SilicaListView {
+            id: pickerList
+
+            anchors {
+                top: pickerHeader.bottom
+                bottom: parent.bottom
+                left: parent.left
+                right: parent.right
+            }
+            clip: true
+            model: root.allItems
+
+            header: BackgroundItem {
+                id: defaultItem
+
+                readonly property bool selected: root.singlePick
+                                                 && !root._targetConfig(root.pickerMode).value
+
+                width: pickerList.width
+                height: root.singlePick ? Theme.itemSizeMedium : 0
+                visible: root.singlePick
+                onClicked: root.chooseTarget("")
+
+                Label {
+                    anchors {
+                        left: parent.left
+                        leftMargin: Theme.horizontalPageMargin + Theme.iconSizeMedium + Theme.paddingLarge
+                        right: defaultCheck.left
+                        rightMargin: Theme.paddingMedium
+                        verticalCenter: parent.verticalCenter
+                    }
+                    text: root.pickerMode === "clock" ? "Default (Clock)" : "Default (Calendar)"
+                    color: defaultItem.selected || defaultItem.highlighted ? Theme.highlightColor : Theme.primaryColor
+                    truncationMode: TruncationMode.Fade
+                }
+
+                Icon {
+                    id: defaultCheck
+
+                    anchors {
+                        right: parent.right
+                        rightMargin: Theme.horizontalPageMargin
+                        verticalCenter: parent.verticalCenter
+                    }
+                    visible: defaultItem.selected
+                    source: "image://theme/icon-m-acknowledge"
+                    color: Theme.highlightColor
+                }
+            }
+
+            delegate: BackgroundItem {
+                id: pickerItem
+
+                readonly property bool selected: root.singlePick
+                                                 ? root._targetConfig(root.pickerMode).value === modelData.filePath
+                                                 : (root.favouriteItems, root.isFavourite(modelData.filePath))
+
+                width: pickerList.width
+                height: Theme.itemSizeMedium
+                enabled: root.singlePick || selected || root.favouriteItems.length < root.maximumFavourites
+                onClicked: {
+                    if (root.singlePick) {
+                        root.chooseTarget(modelData.filePath)
+                    } else {
+                        root.toggleFavourite(modelData.filePath)
+                    }
+                }
+
+                LauncherIcon {
+                    id: icon
+
+                    x: Theme.horizontalPageMargin
+                    anchors.verticalCenter: parent.verticalCenter
+                    icon: modelData.iconId
+                    size: Theme.iconSizeMedium
+                    opacity: pickerItem.enabled ? 1.0 : Theme.opacityLow
+                }
+
+                Label {
+                    anchors {
+                        left: icon.right
+                        leftMargin: Theme.paddingLarge
+                        right: check.left
+                        rightMargin: Theme.paddingMedium
+                        verticalCenter: parent.verticalCenter
+                    }
+                    text: modelData.title
+                    color: pickerItem.selected || pickerItem.highlighted ? Theme.highlightColor : Theme.primaryColor
+                    opacity: pickerItem.enabled ? 1.0 : Theme.opacityLow
+                    truncationMode: TruncationMode.Fade
+                }
+
+                Icon {
+                    id: check
+
+                    anchors {
+                        right: parent.right
+                        rightMargin: Theme.horizontalPageMargin
+                        verticalCenter: parent.verticalCenter
+                    }
+                    visible: pickerItem.selected
+                    source: "image://theme/icon-m-acknowledge"
+                    color: Theme.highlightColor
+                }
+            }
+
+            VerticalScrollDecorator {}
+        }
+    }
+}
