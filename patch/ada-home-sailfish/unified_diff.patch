+/*
+ * ada-home-sailfish: the Events widgets (weather, calendar) above the app covers.
+ * Loads the same widgets as the Events view, from the same registry
+ * (/usr/share/lipstick/eventswidgets/*.json).
+ * License: BSD-3-Clause, see LICENSE in the ada-home-sailfish project
+ */
+
+import QtQuick 2.6
+import Sailfish.Silica 1.0
+import com.jolla.lipstick 0.1
+import com.jolla.settings.system 1.0 // EventsWidgetsModel
+import Nemo.Configuration 1.0
+
+Column {
+    id: root
+
+    // The stock widgets read this name from the page that loads them
+    property bool eventsViewVisible
+
+    spacing: Theme.paddingSmall
+
+    // Settings → Layout → Weather header
+    ConfigurationValue {
+        id: weatherHeaderConfig
+
+        key: "/desktop/lipstick-jolla-home/ada_home/weather_header"
+        defaultValue: true
+    }
+
+    EventsWidgetsModel {
+        id: widgetsModel
+        onlyUserConfigurable: false
+    }
+
+    Repeater {
+        model: widgetsModel
+
+        delegate: Column {
+            readonly property bool isWeather: model.path.indexOf("/weather/") !== -1
+
+            width: root.width
+
+            // Section headers for the weather and the calendar (registry paths
+            // .../eventsview/weather/... and .../calendar/...), only when the widget
+            // has loaded and shows something. The weather loader keeps a small
+            // height even when empty, so it counts once its inner item exists.
+            SectionHeader {
+                readonly property bool isCalendar: model.path.indexOf("/calendar/") !== -1
+
+                visible: widgetLoader.status === Loader.Ready && !!widgetLoader.item
+                         && (isWeather ? weatherHeaderConfig.value && !!widgetLoader.item.item
+                                       : isCalendar && widgetLoader.height > 0)
+                text: isWeather ? "Weather" : "Calendar"
+            }
+
+            Loader {
+                id: widgetLoader
+
+                width: parent.width
+                visible: active
+                active: model.enabled
+                source: model.path
+            }
+
+            // Active alarms right below the weather (also when the weather
+            // widget itself is switched off)
+            Loader {
+                width: parent.width
+                active: isWeather
+                visible: active && item && item.count > 0
+                source: "CoversAlarms.qml"
+            }
+        }
+    }
+}
