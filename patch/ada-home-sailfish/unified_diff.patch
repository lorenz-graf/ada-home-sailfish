+                    leftMargin: Theme.paddingLarge
+                    right: parent.right
+                    rightMargin: Theme.horizontalPageMargin
+                    baseline: timeLabel.baseline
+                }
+                text: alarmItem.alarm && alarmItem.alarm.title.length > 0 ? alarmItem.alarm.title : "Alarm"
