@@ -0,0 +1,54 @@
+/*
+ * ada-home-sailfish: settings row "label (description)   [switch]", with
+ * the switch in the shared input column (valueX).
+ * License: BSD-3-Clause, see LICENSE in the ada-home-sailfish project
+ */
+
+import QtQuick 2.6
+import Sailfish.Silica 1.0
+
+BackgroundItem {
+    id: row
+
+    property string label
+    property string description
+    property bool checked
+    property real valueX: width * 0.55
+
+    signal toggled()
+
+    width: parent ? parent.width : 0
+    height: Math.max(Theme.itemSizeSmall, texts.height + 2 * Theme.paddingSmall)
+    onClicked: toggled()
+
+    Column {
+        id: texts
+
+        x: Theme.horizontalPageMargin
+        width: row.valueX - x - Theme.paddingLarge
+        anchors.verticalCenter: parent.verticalCenter
+
+        Label {
+            width: parent.width
+            text: row.label
+            wrapMode: Text.Wrap
+        }
+        Label {
+            width: parent.width
+            visible: text.length > 0
+            text: row.description
+            wrapMode: Text.Wrap
+            font.pixelSize: Theme.fontSizeExtraSmall
+            color: Theme.secondaryColor
+        }
+    }
+
+    Switch {
+        // Line the switch glyph up with the other inputs' left edge
+        x: row.valueX - (width - Theme.iconSizeMedium) / 2
+        anchors.verticalCenter: parent.verticalCenter
+        automaticCheck: false
+        checked: row.checked
+        onClicked: row.toggled()
+    }
+}
diff -ruN a/usr/share/lipstick-jolla-home-qt5/eventsview/HomeTextShadow.qml b/usr/share/lipstick-jolla-home-qt5/eventsview/HomeTextShadow.qml
--- /dev/null
+++ b/usr/share/lipstick-jolla-home-qt5/eventsview/HomeTextShadow.qml
@@ -0,0 +1,27 @@
+/*
+ * ada-home-sailfish: soft text shadow used as a layer effect.
+ * level: 0 off, 1 small, 2 medium, 3 large.
+ * The shadow contrasts with the text: dark shadow behind light text,
+ * light glow behind dark text.
+ * License: BSD-3-Clause, see LICENSE in the ada-home-sailfish project
+ */
+
+import QtQuick 2.6
+import Sailfish.Silica 1.0
+import QtGraphicalEffects 1.0
+
+DropShadow {
+    property int level: 1
+    property color textColor: Theme.primaryColor
+
+    readonly property bool _lightText: (0.299 * textColor.r + 0.587 * textColor.g + 0.114 * textColor.b) > 0.5
+    // Blur radius in pixels: about 4 / 9 / 15 px on this screen (keeps the shader cheap)
+    readonly property real _size: Math.round((level <= 1 ? 3 : level === 2 ? 6 : 10) * Theme.pixelRatio)
+
+    transparentBorder: true
+    horizontalOffset: 0
+    verticalOffset: Math.max(1, Math.round(_size / 3))
+    radius: _size
+    samples: 2 * Math.round(_size) + 1
+    color: _lightText ? Qt.rgba(0, 0, 0, 0.45 + 0.1 * level) : Qt.rgba(1, 1, 1, 0.45 + 0.1 * level)
+}
