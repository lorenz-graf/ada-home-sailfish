diff -ruN a/usr/share/lipstick-jolla-home-qt5/eventsview/HomeSettingsStepper.qml b/usr/share/lipstick-jolla-home-qt5/eventsview/HomeSettingsStepper.qml
--- /dev/null
+++ b/usr/share/lipstick-jolla-home-qt5/eventsview/HomeSettingsStepper.qml
@@ -0,0 +1,67 @@
+/*
+ * ada-home-sailfish: settings row "label  [-] value [+]".
+ * License: BSD-3-Clause, see LICENSE in the ada-home-sailfish project
+ */
+
+import QtQuick 2.6
+import Sailfish.Silica 1.0
+
+Item {
+    id: stepper
+
+    property string label
+    property real value
+    property real minimum: 0
+    property real maximum: 10
+    property real step: 1
+    property int decimals: 0
+    // Shown instead of the minimum value, e.g. "Auto"
+    property string minimumText
+    // Left edge of the input column, shared by all settings rows
+    property real valueX: width * 0.55
+
+    signal stepped(real newValue)
+
+    function _round(v) {
+        var f = Math.pow(10, decimals)
+        return Math.round(v * f) / f
+    }
+
+    width: parent ? parent.width : 0
+    height: Math.max(Theme.itemSizeSmall, buttons.height)
+
+    Label {
+        x: Theme.horizontalPageMargin
+        width: stepper.valueX - x - Theme.paddingLarge
+        anchors.verticalCenter: parent.verticalCenter
+        text: stepper.label
+        wrapMode: Text.Wrap
+    }
+
+    Row {
+        id: buttons
+
+        // The minus icon (not its touch area) starts at valueX
+        x: stepper.valueX - (Theme.itemSizeSmall - Theme.iconSizeMedium) / 2
+        anchors.verticalCenter: parent.verticalCenter
+
+        IconButton {
+            icon.source: "image://theme/icon-m-remove"
+            enabled: stepper.value > stepper.minimum + stepper.step / 2
+            onClicked: stepper.stepped(Math.max(stepper.minimum, stepper._round(stepper.value - stepper.step)))
+        }
+        Label {
+            width: Math.max(Theme.itemSizeSmall, implicitWidth)
+            anchors.verticalCenter: parent.verticalCenter
+            horizontalAlignment: Text.AlignHCenter
+            text: stepper.minimumText.length > 0 && stepper.value <= stepper.minimum
+                  ? stepper.minimumText : Number(stepper.value).toFixed(stepper.decimals)
+            color: Theme.highlightColor
+        }
+        IconButton {
+            icon.source: "image://theme/icon-m-add"
+            enabled: stepper.value < stepper.maximum - stepper.step / 2
+            onClicked: stepper.stepped(Math.min(stepper.maximum, stepper._round(stepper.value + stepper.step)))
+        }
+    }
+}
diff -ruN a/usr/share/lipstick-jolla-home-qt5/eventsview/HomeSettingsSwitch.qml b/usr/share/lipstick-jolla-home-qt5/eventsview/HomeSettingsSwitch.qml
