+/*
+ * ada-home-sailfish: notification list inside the Top menu.
+ * Reuses the stock notification components from ../notifications.
+ * License: BSD-3-Clause, see LICENSE in the ada-home-sailfish project
+ */
+
+import QtQuick 2.6
+import Sailfish.Silica 1.0
+import org.nemomobile.lipstick 0.1
+import org.nemomobile.devicelock 1.0
+import com.jolla.lipstick 0.1
+import "../notifications" as Notifications
+
+Column {
+    id: root
+
+    readonly property bool menuExposed: Lipstick.compositor.topMenuLayer.exposed
+    // Only show notification content when the device is unlocked
+    // (the Top menu can also be opened on the lock screen).
+    readonly property bool allowed: Desktop.deviceLockState === DeviceLock.Unlocked
+    readonly property bool hasNotifications: notificationList.count > 0
+
+    // The Top menu's settings (gear) menu opens below the header
+    property bool settingsMenuOpen
+    property real settingsMenuHeight
+    signal settingsClicked(Item menuParent)
+    signal settingsPressAndHold(Item menuParent)
+
+    width: parent ? parent.width : 0
+
+    onMenuExposedChanged: {
+        if (!menuExposed) {
+            // Same as the Events view does when it is left
+            var ids = []
+            for (var id in notificationList.displayedIds) {
+                ids.push(id)
+            }
+            if (ids.length > 0) {
+                notificationModel.markAsDisplayed(ids)
+            }
+            notificationList.displayedIds = {}
+            Lipstick.compositor.eventsLayer.setHousekeeping(false)
+        }
+    }
+
+    JollaNotificationGroupModel {
+        id: notificationModel
+
+        function markAsDisplayed(ids) {
+            sourceModel.markAsDisplayed(ids)
+        }
+
+        groupProperty: "disambiguatedAppName"
+        sourceModel: JollaNotificationListModel {}
+    }
+
+    Item {
+        id: header
+
+        width: parent.width
+        // The context menu anchors to the bottom of its parent item
+        height: headerRow.height + (root.settingsMenuOpen ? root.settingsMenuHeight : 0)
+
+        Item {
+            id: headerRow
+
+            width: parent.width
+            height: Theme.itemSizeSmall
+
+            Label {
+                anchors {
+                    left: parent.left
+                    leftMargin: Theme.horizontalPageMargin
+                    right: clearButton.left
+                    verticalCenter: parent.verticalCenter
+                }
+                visible: root.allowed
+                text: "Notifications"
+                color: Theme.highlightColor
+                font.pixelSize: Theme.fontSizeSmall
+                truncationMode: TruncationMode.Fade
+            }
+
+            Button {
+                id: clearButton
+
+                anchors {
+                    right: settingsButton.left
+                    rightMargin: Theme.paddingMedium
+                    verticalCenter: parent.verticalCenter
+                }
+                visible: root.allowed && notificationList.hasRemovableNotifications
+                preferredWidth: Theme.buttonWidthExtraSmall
+                text: "Clear all"
+                onClicked: notificationList.removeAll()
+            }
+
+            IconButton {
+                id: settingsButton
+
+                anchors {
+                    right: parent.right
+                    rightMargin: Theme.horizontalPageMargin - Theme.paddingMedium
+                    verticalCenter: parent.verticalCenter
+                }
+                width: Theme.itemSizeSmall
+                height: Theme.itemSizeSmall
+                icon.source: "image://theme/icon-s-setting"
+                highlighted: down || root.settingsMenuOpen
+                onClicked: root.settingsClicked(header)
+                onPressAndHold: root.settingsPressAndHold(header)
+            }
+        }
+    }
+
+    Label {
+        x: Theme.horizontalPageMargin
+        width: parent.width - 2 * Theme.horizontalPageMargin
+        height: visible ? implicitHeight + Theme.paddingLarge : 0
+        visible: root.allowed && !root.hasNotifications
+        text: "No notifications"
+        color: Theme.secondaryHighlightColor
+        font.pixelSize: Theme.fontSizeSmall
+    }
+
+    Item {
+        width: parent.width
+        height: visible ? notificationList.contentHeight : 0
+        visible: root.allowed
+
+        Notifications.NotificationListView {
+            id: notificationList
+
+            property var displayedIds: ({})
+
+            onDisplayed: displayedIds[id] = true
+
+            // Same trick as the Events view: a tall view is fully populated
+            // without binding height to contentHeight.
+            height: Screen.height * 1000
+            model: notificationModel.populated ? notificationModel : null
+            viewVisible: root.menuExposed && root.allowed
+            directSwipe: true
+        }
+    }
+
+    Item {
+        width: 1
+        height: Theme.paddingLarge
+    }
+}
